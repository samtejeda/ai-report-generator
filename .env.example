# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.
#
# Every variable, and the ONLY module that reads it (process.env is lint-banned elsewhere;
# see PROCESS_ENV_ALLOWED in eslint.config.mjs). A deployed environment (Vercel) holds the
# "runtime" variables only, never the migration or test ones.

# --- Runtime (set in Vercel) -----------------------------------------------------------------
# Read by lib/env.ts (getEnv()).

# Neon POOLED connection string (host contains "-pooler"), as the app_runtime login role
# (see docs/RUNBOOK.md), never the owner. Dev project only until Phase C.
DATABASE_URL=

# Inference (Phase A: local Ollama on the host, stub mode).
INFERENCE_MODE=stub
OLLAMA_BASE_URL=http://localhost:11434/v1

# Authentication. Read by lib/env.ts (getAuthEnv()), the first time auth is used.
# Neon POOLED connection string via the auth_runtime login role (docs/RUNBOOK.md), never the owner
# and never the app_runtime login: it must not be able to read clients or reports.
AUTH_DATABASE_URL=
# Signs session cookies. 32+ random characters (openssl rand -base64 32). A different value per
# environment; changing it signs everyone out.
BETTER_AUTH_SECRET=
# Public origin of the app (used in emailed links and the origin check).
BETTER_AUTH_URL=http://localhost:3000
# Only "console" exists (prints links to the server log). Refused in production.
EMAIL_TRANSPORT=console

# --- Migrations only (your laptop or CI, NEVER Vercel) ---------------------------------------
# Read by drizzle.config.ts only. Owner credential: can run DDL. Not part of the app's env schema.
# Written by `neon link` (branch: dev).
DATABASE_URL_UNPOOLED=

# --- Tooling, not read by any code ------------------------------------------------------------
# Written by `neon link`; nothing reads it. Do not set it in a deployed environment.
NEON_BRANCH=dev

# --- DB integration tests only ----------------------------------------------------------------
# Read by lib/db/integration.test.ts only. Put these in .env.test.local, never in .env.local.
# Point them at a scratch Neon branch (for example `test`), never at dev data you care about.
# Tests skip when absent and never fall back to DATABASE_URL.
# TEST_DATABASE_URL=            # owner role on the scratch branch
# TEST_APP_ROLE_PASSWORD=       # 32+ hex chars; used to create the app_runtime_test login role
# (TEST_DATABASE_URL_UNPOOLED appeared in earlier docs but no code reads it; do not set it.)

# --- Set by the platform, never by us ---------------------------------------------------------
# NODE_ENV (next.config.ts) and NEXT_RUNTIME (instrumentation.ts) are provided by Next.js.
