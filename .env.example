# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Neon POOLED connection string (host contains "-pooler"). Dev project only until Phase C.
DATABASE_URL=

# Inference (Phase A: local Ollama on the host, stub mode)
INFERENCE_MODE=stub
OLLAMA_BASE_URL=http://localhost:11434/v1

# Written by `neon link` (branch: dev). UNPOOLED is for drizzle-kit migrations run locally/CI only;
# never use it from serverless app code (see CLAUDE.md).
DATABASE_URL_UNPOOLED=
NEON_BRANCH=dev

# DB integration tests only (lib/db/integration.test.ts); put these in .env.test.local, never in .env.local.
# Point them at a scratch Neon branch (for example `test`), never at dev data you care about.
# Tests skip when absent and never fall back to DATABASE_URL.
# TEST_DATABASE_URL=            # pooled, owner role
# TEST_DATABASE_URL_UNPOOLED=   # direct, owner role
# TEST_APP_ROLE_PASSWORD=       # 32+ hex chars; used to create the app_runtime_test login role
